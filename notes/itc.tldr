66210938,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"example: one symbol x"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"P(x) = 0.25"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"if we take l(x) = -log(P(x)) = 2, which means a 2-bit codeword"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"so 2  = 0.25"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"if we assign 01 to x, 0.01 represents all numbers the interval [0.25, 0.5)"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"so here, 2  = P(x) which is a boundary condition and can cause prefix issues"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"But, if we take l(x) = -logP(x) + 1 = 3 which means a 3-bit codeword"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"2  = 0.125"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"if we assign 010 to x, 0.010 represents all numbers in the interval [0.25, 0.375)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"So, it fits well inside the range"}]}]}},"parentId":"shape:SkDwU7OCLUNuoM5OZmzA3","index":"a1","typeName":"shape"},{"x":46.98486336427413,"y":148.2090704350976,"rotation":0,"isLocked":false,"opacity":0.75,"meta":{},"id":"shape:twlo0aV_aQ0SFGzpO2OGn","type":"text","props":{"color":"light-blue","size":"m","w":21.575000762939453,"font":"draw","textAlign":"start","autoSize":true,"scale":0.7980227304475246,"richText":{"type
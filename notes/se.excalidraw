      "updated": 1764598130772,
      "link": null,
      "locked": false,
      "text": "Coding Practices\n    + Commenting & Documentation\n    + Consistent Indentation\n    + Avoid Obvious Comments\n    + Consistent Naming Scheme\n    + DRY Principle - Don't Repeat Yourself\n    + Avoid Deep Nesting\n    + Limit Line Length\n    + Separation of Code and Data",
      "fontSize": 43.38221116489177,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Coding Practices\n    + Commenting & Documentation\n    + Consistent Indentation\n    + Avoid Obvious Comments\n    + Consistent Naming Scheme\n    + DRY Principle - Don't Repeat Yourself\n    + Avoid Deep Nesting\n    + Limit Line Length\n    + Separation of Code and Data",
      "autoResize": false,
      "lineHeight": 1.25
    },

      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "Software is released to end-user\n\n• within days, bug reports filter back to the software engineers.\n\n• within weeks, one class of mfs realise that the software must be changed so that it can\naccommodate the special needs of their environment.\n\n• within months, another corporate shyt group who had nothing to do with the software\nwhen it was released, now recognizes that it may provide them with unexpected benefits.",
      "fontSize": 38.28617875562132,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Software is released to end-user\n\n• within days, bug reports filter back to the software engineers.\n\n• within weeks, one class of mfs realise that the software must be changed so that it can accommodate the special needs of their environment.\n\n• within months, another corporate shyt group who had nothing to do with the software when it was released, now recognizes that it may provide them with unexpected benefits.",
      "autoResize": false,
      "lineHeight": 1.25
    },

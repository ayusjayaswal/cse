      "isDeleted": false,
      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "fixing errors\nthat are\nobserved\nwhen the\nsoftware is\nin use. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fixing errors that are\nobserved when the software is in use. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TlD41GVrMxW6elPS1sk4w",
      "type": "text",
      "x": 10040.644400191322,
      "y": 592.3571126135803,
      "width": 307.08847759651496,
      "height": 315,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

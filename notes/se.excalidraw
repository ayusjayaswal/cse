      "updated": 1764598115863,
      "link": null,
      "locked": false,
      "text": "Debugging Strategies\n    + Brute Force\n    + Backtracking (for small programs)\n    + Cause Elimination\n    + Program Slicing",
      "fontSize": 43.41572232496268,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Debugging Strategies\n    + Brute Force\n    + Backtracking (for small programs)\n    + Cause Elimination\n    + Program Slicing",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "r54f6lR6RKNfcOHJJK8yh",

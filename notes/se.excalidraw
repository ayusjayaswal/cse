      "updated": 1764603657013,
      "link": null,
      "locked": false,
      "text": "RELATIONSHIPS between classes\n        n--m|* dalna\n\nGeneralization:\n    • inheritance between classes\n    • interface\n\nAssociation: usage relationship\n    • dependency: \"uses temporarily\"\n    • aggregation: \"is part of\"\n    • composition: \"is entirely made of\"",
      "fontSize": 33.538187222854425,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RELATIONSHIPS between classes\n        n--m|* dalna\n\nGeneralization:\n    • inheritance between classes\n    • interface\n\nAssociation: usage relationship\n    • dependency: \"uses temporarily\"\n    • aggregation: \"is part of\"\n    • composition: \"is entirely made of\"",
      "autoResize": false,
      "lineHeight": 1.25
    },

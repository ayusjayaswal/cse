    {
      "id": "evKQxYj2TVP8mUOw865LO",
      "type": "text",
      "x": 31624.528050347137,
      "y": -6021.473441870845,
      "width": 706.6793212890625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QKS_e_XA9Wp4fKvGU0Lol"
      ],
      "frameId": null,
      "index": "bHR",
      "roundness": null,
      "seed": 1410254351,
      "version": 723,
      "versionNonce": 108842593,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764583425819,
      "link": null,
      "locked": false,
      "text": "Functional\n    + essential element in single computation contained in the component.\nSequence\n    + output of A = input of B\nCommunicational\n    + 2 elements operate on same i/p; same o/p\nProcedural\n    + ensure order of execution\nTemporal\n    + timing\nLogical\n    + logically related not functionally\nCoincidental\n    + unrelated elements",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional\n    + essential element in single computation contained in the component.\nSequence\n    + output of A = input of B\nCommunicational\n    + 2 elements operate on same i/p; same o/p\nProcedural\n    + ensure order of execution\nTemporal\n    + timing\nLogical\n    + logically related not functionally\nCoincidental\n    + unrelated elements",
      "autoResize": true,
      "lineHeight": 1.25

      "seed": 1245752655,
      "version": 817,
      "versionNonce": 1320957903,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764583435796,
      "link": null,
      "locked": false,
      "text": "Data Coupling\n    + data shared through parameters\nStamp Coupling\n    + share composite data structures but use only parts\nControl Coupling\n    + one module controlling flow of another (what to do flag)\nExternal Coupling\n    + share an externally exposed data format\nCommon Coupling\n    + several modules have access to global data\nContent Coupling\n    + one module uses code of another module",
      "fontSize": 21.192465348405985,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Coupling\n    + data shared through parameters\nStamp Coupling\n    + share composite data structures but use only parts\nControl Coupling\n    + one module controlling flow of another (what to do flag)\nExternal Coupling\n    + share an externally exposed data format\nCommon Coupling\n    + several modules have access to global data\nContent Coupling\n    + one module uses code of another module",
      "autoResize": true,
      "lineHeight": 1.25
    },

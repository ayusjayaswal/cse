      ],
      "frameId": "nmdQ86d6GcWHU9s4PiMlj",
      "index": "bDT",
      "roundness": null,
      "seed": 2143055072,
      "version": 799,
      "versionNonce": 1017360608,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764511352212,
      "link": null,
      "locked": false,
      "text": "An aspect is a representation\nof a cross-cutting concern. \n\nRequirement A crosscuts\nrequirement B “if a software\ndecomposition [refinement] has\nbeen chosen in which B cannot\nbe satisfied without taking A\ninto account.\"",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An aspect is a representation of a cross-cutting concern. \n\nRequirement A crosscuts\nrequirement B “if a software decomposition [refinement] has been chosen in which B cannot be satisfied without taking A into account.\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZMW6F8GenF8O0XI3nfaSx",
      "type": "text",
      "x": 30559.80493437599,
      "y": 6416.159095432977,
      "width": 648.8155529908252,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "e9pnScmRsSq_MUGJpNfyG"
      ],
      "frameId": "nmdQ86d6GcWHU9s4PiMlj",
      "index": "bDU",
      "roundness": null,
      "seed": 691307744,
      "version": 1000,
      "versionNonce": 357846304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764511352212,
      "link": null,
      "locked": false,
      "text": "\"Refactoring is the process of\nchanging a software system in such\na way that it does not alter the\nexternal behavior of the code yet\nimproves its internal structure.”",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Refactoring is the process of changing a software system in such a way that it does not alter the external behavior of the code yet improves its internal structure.”",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "q-DO8P36YgBHDKBLuaOES",
      "type": "text",
      "x": 29646.4822781887,
      "y": 6329.599409996845,
      "width": 784.4371310536269,
      "height": 418.31415138541814,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "e9pnScmRsSq_MUGJpNfyG"
      ],
      "frameId": "nmdQ86d6GcWHU9s4PiMlj",
      "index": "bDV",
      "roundness": null,
      "seed": 1067780384,
      "version": 1193,
      "versionNonce": 1387959520,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "SLynhBZtASNFWfyGIcQe0",
          "type": "arrow"
        }
      ],
      "updated": 1764511352212,
      "link": null,
      "locked": false,
      "text": "When software is refactored, the existing\ndesign is examined for:\n\n• redundancy\n• unused design elements\n• inefficient or unnecessary algorithms\n• poorly constructed data structures\n• any other design failure that can be\ncorrected",
      "fontSize": 37.18348012314828,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When software is refactored, the existing design is examined for:\n\n• redundancy\n• unused design elements\n• inefficient or unnecessary algorithms\n• poorly constructed data structures\n• any other design failure that can be corrected",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SLynhBZtASNFWfyGIcQe0",
      "type": "arrow",
      "x": 30394.089272181696,
      "y": 6425.873287620561,
      "width": 126.07399244137196,
      "height": 36.964769514140244,
      "angle": 3.157892291680941,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "e9pnScmRsSq_MUGJpNfyG"
      ],
      "frameId": "nmdQ86d6GcWHU9s4PiMlj",
      "index": "bDW",
      "roundness": {

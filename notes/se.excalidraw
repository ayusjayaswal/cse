      "text": "Concerns the\ncomposition of\nclasses and objects",
      "fontSize": 26.348373922763106,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Concerns the composition of classes and objects",

      "seed": 189508832,
      "version": 584,
      "versionNonce": 2090354363,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764603458343,
      "link": null,
      "locked": false,
      "text": "Dependency Notation\n\n• <<import>> - one package imports the\nfunctionality of other\n• <<access>> - one package requires help\nfrom functions of other package\n• <<merge>> - indicates that the contents\nof the two packages are to be combined.",
      "fontSize": 32.430649663319485,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dependency Notation\n\n• <<import>> - one package imports the functionality of other\n• <<access>> - one package requires help from functions of other package\n• <<merge>> - indicates that the contents of the two packages are to be combined.",
      "autoResize": false,
      "lineHeight": 1.25
    },

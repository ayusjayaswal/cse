      "isDeleted": false,
      "boundElements": [],
      "updated": 1764591503936,
      "link": null,
      "locked": false,
      "text": "Regression Testing: Re-run the old test\ncases on introducing every new change -> to\ncheck if the new change has introduced any\nnew bugs\n\nMust be automated so that all test cases\nare run after each modification to the\nsoftware",
      "fontSize": 41.849894429812124,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Regression Testing: Re-run the old test cases on introducing every new change -> to check if the new change has introduced any new bugs\n\nMust be automated so that all test cases are run after each modification to the software",
      "autoResize": false,
      "lineHeight": 1.25
    },

      "type": "text",
      "x": 21326.06890856178,
      "y": 2526.1152085163717,
      "width": 713.0917163146956,
      "height": 324.30649663319485,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "HF6vU6thaUYOknkUxiIWi"

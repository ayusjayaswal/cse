      "versionNonce": 1020930759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "Re-engineering: rewriting part or all of a system\nwithout changing its functionality.\n\n+ to bring the poorly maintained and controlled\ncode to an acceptable standard.",
      "fontSize": 75.88843395761104,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Re-engineering: rewriting part or all of a system\nwithout changing its functionality.\n\n+ to bring the poorly maintained and controlled code to an acceptable standard.",
      "autoResize": false,
      "lineHeight": 1.25
    },

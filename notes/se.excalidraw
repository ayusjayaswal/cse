      "id": "Jl5JkHh5fMKTL1EIOJKUL",
      "type": "text",
      "x": 39432.73149630284,
      "y": 1929.1474222874203,
      "width": 515.9198498196422,
      "height": 337.3154327095198,
      "angle": 0,
      "strokeColor": "#0000ff",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "kpbGOZegG5Dyono6Kd8Pk"
      ],
      "frameId": null,
      "index": "bFd",

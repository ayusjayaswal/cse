      "link": null,
      "locked": false,
      "text": "specifies the sequences of states\nthat an object can be in, the\nconditions which cause the object\nto reach those states, and the\nactions which take place when\nthose states are reached.",
      "fontSize": 25.79906332811697,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "specifies the sequences of states that an object can be in, the conditions which cause the object to reach those states, and the actions which take place when those states are reached.",
      "autoResize": false,
      "lineHeight": 1.25
    },

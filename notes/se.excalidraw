    {
      "id": "l-jepvX6tJ76eZG-y8hRQ",
      "type": "text",
      "x": 40712.58056148011,
      "y": 2997.7938121725083,
      "width": 695.6697258567997,
      "height": 488.7664232200751,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

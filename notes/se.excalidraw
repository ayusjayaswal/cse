      "versionNonce": 1143103655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "Process evaluation: The existing\nprocess is thoroughly analyzed\nand measured. ",
      "fontSize": 51.73739938801982,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Process evaluation: The existing process is thoroughly analyzed\nand measured. ",
      "autoResize": false,
      "lineHeight": 1.25
    },

    {
      "id": "iAsjVqRu1F2Ck87sY9IZq",
      "type": "text",
      "x": 39818.06097123901,
      "y": 4026.0660438482664,
      "width": 648.5693634511468,
      "height": 58.81368857440608,
      "angle": 0,
      "strokeColor": "#1e1e1e",

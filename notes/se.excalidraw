      "index": "b4T",
      "roundness": null,
      "seed": 649078048,
      "version": 934,
      "versionNonce": 35431783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "make the\nsoftware\nadaptable to new\nenvironments\nsuch as to run\nthe software on\na new OS",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "make the software adaptable to new environments\nsuch as to run the software on a new OS",
      "autoResize": false,
      "lineHeight": 1.25
    },

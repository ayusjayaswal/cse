      "isDeleted": false,
      "boundElements": [],
      "updated": 1764600680243,
      "link": null,
      "locked": false,
      "text": "Business definition: Business goals are\nidentified within the context of four key\ndrivers: \n    + cost reduction\n    + time reduction\n    + quality improvement\n    + personnel development & empowerment",
      "fontSize": 50.06791795352485,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Business definition: Business goals are identified within the context of four key drivers: \n    + cost reduction\n    + time reduction\n    + quality improvement\n    + personnel development & empowerment",

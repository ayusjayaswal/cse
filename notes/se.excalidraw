      "updated": 1764511352212,
      "link": null,
      "locked": false,
      "text": "Based on these properties,\narchitectural design can be\nrepresented using models",
      "fontSize": 24.671758104954648,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Based on these properties,\narchitectural design can be represented using models",
      "autoResize": false,
      "lineHeight": 1.25
    },

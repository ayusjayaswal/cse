    {
      "id": "ifgxhv85smhR_klvxW43L",
      "type": "text",
      "x": 29219.16787635577,
      "y": 3553.5805282348974,
      "width": 1547.859561606085,
      "height": 282.479069333194,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "VbYYi0BeLXNMh7gT_zD-A"
      ],
      "frameId": null,
      "index": "b7O",
      "roundness": null,
      "seed": 1367083296,
      "version": 430,
      "versionNonce": 668943648,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764488847290,
      "link": null,
      "locked": false,
      "text": "The “+” of the FURPS+ acronym allows us to specify:\n\n• Design constraints – limits the design\n• Implementation constraints – limits on coding or construction.\n• Interface constraints – a requirement to interact with an external item.\n• Physical constraints – affect the hardware used to house the system.",
      "fontSize": 37.66387591109253,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The “+” of the FURPS+ acronym allows us to specify:\n\n• Design constraints – limits the design\n• Implementation constraints – limits on coding or construction.\n• Interface constraints – a requirement to interact with an external item.\n• Physical constraints – affect the hardware used to house the system.",
      "autoResize": false,
      "lineHeight": 1.25
    },

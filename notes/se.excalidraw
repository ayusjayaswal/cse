      ],
      "updated": 1764488808254,
      "link": null,
      "locked": false,
      "text": "Characterizes the\ninteraction and\nresponsibility of objects\nand classes",
      "fontSize": 24.328615884518317,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Characterizes the interaction and responsibility of objects\nand classes",

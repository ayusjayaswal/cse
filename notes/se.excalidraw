    },
    {
      "id": "vVthV4NRIdjDuHO6bqTmt",
      "type": "text",
      "x": 38860.36482731995,
      "y": 6292.846160268135,
      "width": 1183.5806156810427,
      "height": 599.9311091606905,
      "angle": 0,
      "strokeColor": "#e64980",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "bjqVrVm5IRd12iEcZGdaU",
      "index": "bGU",
      "roundness": null,
      "seed": 824526048,
      "version": 309,
      "versionNonce": 764837152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764506159583,
      "link": null,
      "locked": false,
      "text": "• Assigns components to layers in order to control inter-\ncomponent interaction\n\n• Only allows a layer to communicate with its immediate neighbor\n\n• Assigns core functionality such as hardware interfacing or\nsystem kernel operations to the lowest layer\n\n• Builds each successive layer on its predecessor, hiding the\nlower layer and providing services for the upper layer\n\n• Is compromised by layer bridging that skips one or more layers\nto improve runtime performance",
      "fontSize": 36.918837486811725,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Assigns components to layers in order to control inter-component interaction\n\n• Only allows a layer to communicate with its immediate neighbor\n\n• Assigns core functionality such as hardware interfacing or system kernel operations to the lowest layer\n\n• Builds each successive layer on its predecessor, hiding the lower layer and providing services for the upper layer\n\n• Is compromised by layer bridging that skips one or more layers to improve runtime performance",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "_1OsFptjnkKa1ysduQEpT",
      "type": "text",
      "x": 40515.00766591902,
      "y": 6111.267572995225,
      "width": 617.2968333030859,
      "height": 337.4066833420893,
      "angle": 0,
      "strokeColor": "#099268",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "bjqVrVm5IRd12iEcZGdaU",
      "index": "bGV",
      "roundness": null,
      "seed": 589267168,
      "version": 286,
      "versionNonce": 1812584736,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764506159583,
      "link": null,
      "locked": false,
      "text": "WHEN TO USE THIS\n\nUse this style when the order of\ncomputation is fixed, when interfaces\nare specific, and when components\ncan make no useful progress while\nawaiting the results of request to\nother components ",
      "fontSize": 33.740668334208934,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN TO USE THIS\n\nUse this style when the order of computation is fixed, when interfaces are specific, and when components can make no useful progress while awaiting the results of request to other components ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-m95CSXwyT6utj6qzITq-",
      "type": "text",
      "x": 40371.416142631235,
      "y": 5288.42198595256,
      "width": 514.9964124701874,
      "height": 360,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "bjqVrVm5IRd12iEcZGdaU",
      "index": "bGX",
      "roundness": null,
      "seed": 475371744,
      "version": 403,
      "versionNonce": 1001501984,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764506159583,
      "link": null,
      "locked": false,
      "text": "ADVANTAGES\n\n+ Scalability\n+ Data Integrity\n+ Reusability\n+ Reduced Distribution\n+ Improved Security\n+ Improved Availability",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ADVANTAGES\n\n+ Scalability\n+ Data Integrity\n+ Reusability\n+ Reduced Distribution\n+ Improved Security\n+ Improved Availability",
      "autoResize": false,
      "lineHeight": 1.25
    },

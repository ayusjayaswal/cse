    {
      "id": "xzc2kVakZ7uCF6U3rF10h",
      "type": "text",
      "x": 2842.2262672935435,
      "y": 1055.7421171256199,
      "width": 719.7050720946276,
      "height": 850,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": "OVcHmnC6Pa6DLmF1SV2nJ",
      "index": "b0Yzt",

      "isDeleted": false,
      "boundElements": [],
      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "JDialog\n    secondary window used for messages, forms, or options.\n    Can be modal or modeless.\n    wont exist inside another container but must have an owner (JFrame or JDialog).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JDialog\n    secondary window used for messages, forms, or options.\n    Can be modal or modeless.\n    wont exist inside another container but must have an owner (JFrame or JDialog).",
      "autoResize": true,
      "lineHeight": 1.25
    },

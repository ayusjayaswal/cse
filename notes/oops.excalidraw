      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "// JRadioButton\n\n        JRadioButton yes = new JRadioButton(\"Yes\");\n        JRadioButton no = new JRadioButton(\"No\");\n\n        // Group them so only one is selected at a time\n        ButtonGroup group = new ButtonGroup();\n        group.add(yes);\n        group.add(no);\n\n        // Add action listeners\n        yes.addActionListener(this);\n        no.addActionListener(this);\n\n        jf.add(yes);\n        jf.add(no);\n\n        jf.setSize(300, 200);\n        jf.setVisible(true);\n        jf.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n    }\n\n    @Override\n    public void actionPerformed(ActionEvent e) {\n\n        if (e.getSource() == yes)\n            label.setText(\"You selected YES\");\n\n        else if (e.getSource() == no)\n            label.setText(\"You selected NO\");\n    }",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// JRadioButton\n\n        JRadioButton yes = new JRadioButton(\"Yes\");\n        JRadioButton no = new JRadioButton(\"No\");\n\n        // Group them so only one is selected at a time\n        ButtonGroup group = new ButtonGroup();\n        group.add(yes);\n        group.add(no);\n\n        // Add action listeners\n        yes.addActionListener(this);\n        no.addActionListener(this);\n\n        jf.add(yes);\n        jf.add(no);\n\n        jf.setSize(300, 200);\n        jf.setVisible(true);\n        jf.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n    }\n\n    @Override\n    public void actionPerformed(ActionEvent e) {\n\n        if (e.getSource() == yes)\n            label.setText(\"You selected YES\");\n\n        else if (e.getSource() == no)\n            label.setText(\"You selected NO\");\n    }",
      "autoResize": false,
      "lineHeight": 1.25
    },

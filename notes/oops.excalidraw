    {
      "id": "hNyqutufzjOfAAjDGANtG",
      "type": "text",
      "x": 8601.399609351221,
      "y": -435.4572912176127,
      "width": 769.9989624023438,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0XzzzzzzzzV",
      "roundness": null,
      "seed": 1261534452,
      "version": 160,
      "versionNonce": 382822732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764704018017,
      "link": null,
      "locked": false,
      "text": "public synchronized void guardedAction() throws InterruptedException {\n    // CONDITION must be checked in a while loop\n    while (conditionIsNotMet) { \n        wait(); // Releases the lock and waits\n    }\n    // Condition is met, acquire lock, execute the action.\n    // ...\n}\n\npublic synchronized void signalingAction() {\n    // Modify the shared resource to meet the condition\n    // ...\n    conditionIsNowMet = true;\n    notifyAll(); // Wakes up all waiting threads\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public synchronized void guardedAction() throws InterruptedException {\n    // CONDITION must be checked in a while loop\n    while (conditionIsNotMet) { \n        wait(); // Releases the lock and waits\n    }\n    // Condition is met, acquire lock, execute the action.\n    // ...\n}\n\npublic synchronized void signalingAction() {\n    // Modify the shared resource to meet the condition\n    // ...\n    conditionIsNowMet = true;\n    notifyAll(); // Wakes up all waiting threads\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oUAp415zU-X473CCYyfQ6",

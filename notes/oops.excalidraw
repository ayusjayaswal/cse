      "text": "import javax.swing.*;\nimport java.awt.*;\n...\n\nJFrame x = new JFrame(\"chijji\");\n\n    x.setLayout(new FlowLayout());\n    \nJLabel label = new JLabel(\"Bhondu kahin ki\");\n    x.add(label);\n\nJTextField tf = new JTextField(9);\n    x.add(tf);\n\n    String s = tf.getText();\n    int s = Integer.parseInt(tf.getText());\n\nJButton btn = new JButton(\"tickle tuli\");\n    x.add(btn);\n    btn.setText(\"tickle tuli more\");\n\n    btn.addActionListener(e -> {\n        //// tuli laughing too hardddd\n    });\n\n    x.setTitle(\"chijji\");\n    x.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n    x.setSize(25,01);\n    x.setVisible(true);\n    //important ki ye last me ho\n",

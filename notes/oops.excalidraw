      "updated": 1764729634925,
      "link": null,
      "locked": false,
      "text": "ArrayList<Integer> a = new ArrayList<Integer>(n);\na.add(1);\nIterator<Integer> it = a.iterator();\nwhile(it.hasNext()){\n    int now = it.next() // <- gives it and moves it forwards    \n}\nIterator<Integer> lit = a.listIterator();\nwhile(lit.hasPrevious()){\n    int mow = lit.previous();\n}\n\na.ensureCapacity(int x)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ArrayList<Integer> a = new ArrayList<Integer>(n);\na.add(1);\nIterator<Integer> it = a.iterator();\nwhile(it.hasNext()){\n    int now = it.next() // <- gives it and moves it forwards    \n}\nIterator<Integer> lit = a.listIterator();\nwhile(lit.hasPrevious()){\n    int mow = lit.previous();\n}\n\na.ensureCapacity(int x)",
      "autoResize": true,
      "lineHeight": 1.25
    },

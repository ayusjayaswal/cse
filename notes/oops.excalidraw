      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "//adding image to buttons\n\nImageIcon ayus = new ImageIcon(\"ayus.png\");\nJButton budmos = new JButton(ayus);\nbudmos.setActionCommand(\"budmos\");\nbudmos.addActionListener(this);\n\nImageIcon tultul = new ImageIcon(\"tultul.png\");\nJButton bhondi = new JButton(tultul);\nbudmos.setActionCommand(\"bhondi\");\nbhondi.addActionListener(this);\n\nJLabel label = new JLabel(\"kon sbse gaddar???\");\njf.add(budmos);\njf.add(bhondi);\njf.add(label);\n\njf.setVisible(true);\n\n} // closing constructor block\n\n@Override\npublic void actionPerformed(ActionEvent e) {\n    label.setText(e.getActionCommand() + \"sbse gaddarii\");\n}\n\n\n",
      "fontSize": 19.03193696132082,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//adding image to buttons\n\nImageIcon ayus = new ImageIcon(\"ayus.png\");\nJButton budmos = new JButton(ayus);\nbudmos.setActionCommand(\"budmos\");\nbudmos.addActionListener(this);\n\nImageIcon tultul = new ImageIcon(\"tultul.png\");\nJButton bhondi = new JButton(tultul);\nbudmos.setActionCommand(\"bhondi\");\nbhondi.addActionListener(this);\n\nJLabel label = new JLabel(\"kon sbse gaddar???\");\njf.add(budmos);\njf.add(bhondi);\njf.add(label);\n\njf.setVisible(true);\n\n} // closing constructor block\n\n@Override\npublic void actionPerformed(ActionEvent e) {\n    label.setText(e.getActionCommand() + \"sbse gaddarii\");\n}\n\n\n",
      "autoResize": false,

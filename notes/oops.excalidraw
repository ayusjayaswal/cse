      "link": null,
      "locked": false,
      "text": "// JTabbedPane\n    \n    JTabbedPane jtp = new JTabbedPane();\n    \n    // Add tabs with their respective panels\n    jtp.addTab(\"Cities\", new CitiesPanel());\n    jtp.addTab(\"Colors\", new ColorsPanel());\n    jtp.addTab(\"Flavors\", new FlavorsPanel());\n    \n    jf.add(jtp);\n    jf.setVisible(true);\n    \n    }\n\n    public static void main(String [] args) {\n    // whi sb\n    }\n}\n\n\nclass CitiesPanel extends JPanel {\n     public CitiesPanel() {\n         add(new JButton(\"New York\"));\n         // bla bla bla\n     }\n}\n\nclass ColorsPanel extends JPanel {\n    // bla bla\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// JTabbedPane\n    \n    JTabbedPane jtp = new JTabbedPane();\n    \n    // Add tabs with their respective panels\n    jtp.addTab(\"Cities\", new CitiesPanel());\n    jtp.addTab(\"Colors\", new ColorsPanel());\n    jtp.addTab(\"Flavors\", new FlavorsPanel());\n    \n    jf.add(jtp);\n    jf.setVisible(true);\n    \n    }\n\n    public static void main(String [] args) {\n    // whi sb\n    }\n}\n\n\nclass CitiesPanel extends JPanel {\n     public CitiesPanel() {\n         add(new JButton(\"New York\"));\n         // bla bla bla\n     }\n}\n\nclass ColorsPanel extends JPanel {\n    // bla bla\n}\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aYfWhQSIEgkNt4KX9r11E",
      "type": "text",
      "x": 4157.228892952943,
      "y": 1103.9540406656884,
      "width": 644.9409237417009,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],

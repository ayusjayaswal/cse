      "isDeleted": false,
      "boundElements": [],
      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "// JCheckBox\n\n// On selecting or deselecting a check box, an ItemEvent is\ngenerated.\n\nJCheckBox yes = new JCheckBox(\"yes\");\nyes.addItemListener(this);\njf.add(yes);\n\nJCheckBox no = new JCheckBox(\"fk no\");\nno.addItemListener(this);\njf.add(no);\n\n} // closing constructor block\n\n@Override\npublic void itemStateChanged(ItemEvent e) {\n        JCheckBox chkd = (JCheckBox) e.getItemSelectable();\n\n        // Check which checkbox triggered\n        if (chkd == yes) {\n            if (yes.isSelected()) \n                label.setText(\"You said YES\");\n            else\n                label.setText(\"You unchecked YES\");\n        }\n\n        if (chkd == no) {\n            if (no.isSelected())\n                label.setText(\"You said NO\");\n            else\n                label.setText(\"You unchecked NO\");\n        }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// JCheckBox\n\n// On selecting or deselecting a check box, an ItemEvent is generated.\n\nJCheckBox yes = new JCheckBox(\"yes\");\nyes.addItemListener(this);\njf.add(yes);\n\nJCheckBox no = new JCheckBox(\"fk no\");\nno.addItemListener(this);\njf.add(no);\n\n} // closing constructor block\n\n@Override\npublic void itemStateChanged(ItemEvent e) {\n        JCheckBox chkd = (JCheckBox) e.getItemSelectable();\n\n        // Check which checkbox triggered\n        if (chkd == yes) {\n            if (yes.isSelected()) \n                label.setText(\"You said YES\");\n            else\n                label.setText(\"You unchecked YES\");\n        }\n\n        if (chkd == no) {\n            if (no.isSelected())\n                label.setText(\"You said NO\");\n            else\n                label.setText(\"You unchecked NO\");\n        }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {

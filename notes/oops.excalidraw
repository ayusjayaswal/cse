    {
      "id": "jnOo4pP-pTsWxHt3SpLyA",
      "type": "text",
      "x": 1402.897579507421,
      "y": 1042.6133832204866,
      "width": 661.3846574962919,
      "height": 671.6010854686922,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": "OVcHmnC6Pa6DLmF1SV2nJ",
      "index": "b0Yt",
      "roundness": null,
      "seed": 1088818659,
      "version": 1085,
      "versionNonce": 1013411299,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "// example for splitting a frame into 2 halves and adding\nscrollable text input to the lower half\n\n\nJFrame jf = new JFrame(\"BUDMOSI\");\njf.setSize(800,800);\n\nJSplitPane sp = new JSplitPane();\nsp.setOrientation(JSplitPane.VERTICAL_SPLIT);\nsp.setDividerLocation(400);\n\n//upper half\nJPanel upper = new JPanel();\n\n//lower half\nJPanel lower = new JPanel();\nlower.setLayout(new FlowLayout()); // yfir koi v layout\n\nJTextArea textin = new JTextArea();\nJScrollPane scroll = new JScrollPane(textin);\n\nlower.add(scroll);\n\n//configuring upper and lower panels\nsp.setTopComponent(upper);\nsp.setLowerComponent(lower);\n\njf.add(sp);\njf.setVisible(true);",
      "fontSize": 18.526926495688063,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// example for splitting a frame into 2 halves and adding scrollable text input to the lower half\n\n\nJFrame jf = new JFrame(\"BUDMOSI\");\njf.setSize(800,800);\n\nJSplitPane sp = new JSplitPane();\nsp.setOrientation(JSplitPane.VERTICAL_SPLIT);\nsp.setDividerLocation(400);\n\n//upper half\nJPanel upper = new JPanel();\n\n//lower half\nJPanel lower = new JPanel();\nlower.setLayout(new FlowLayout()); // yfir koi v layout\n\nJTextArea textin = new JTextArea();\nJScrollPane scroll = new JScrollPane(textin);\n\nlower.add(scroll);\n\n//configuring upper and lower panels\nsp.setTopComponent(upper);\nsp.setLowerComponent(lower);\n\njf.add(sp);\njf.setVisible(true);",
      "autoResize": false,
      "lineHeight": 1.25
    },

      "isDeleted": false,
      "boundElements": [],
      "updated": 1764710395947,
      "link": null,
      "locked": false,
      "text": "Layout Managers\n    + FlowLayout(default)\n                FlowLayout()\n                FlowLayout(int how)\n                FLowLayout(int how, int horz, int vert)\n                        how = FlowLayout.LEFT|CENTER|RIGHT|LEADING|TRAILING\n                        horz, vert = gaps\n    + GridLayout\n                GridLayout()\n                GridLayout(int rows, int columns)\n                GridLayout(int rows, int columns, int horz, int vert)\n\n    + GridBagLayout\n                GridBagLayout( )\n                + imp method : setConstraints( )\n                    – void setConstraints(Component comp, GridBagConstraints cons)\n                    – Here, comp is the component for which the constraints cons apply.     ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layout Managers\n    + FlowLayout(default)\n                FlowLayout()\n                FlowLayout(int how)\n                FLowLayout(int how, int horz, int vert)\n                        how = FlowLayout.LEFT|CENTER|RIGHT|LEADING|TRAILING\n                        horz, vert = gaps\n    + GridLayout\n                GridLayout()\n                GridLayout(int rows, int columns)\n                GridLayout(int rows, int columns, int horz, int vert)\n\n    + GridBagLayout\n                GridBagLayout( )\n                + imp method : setConstraints( )\n                    – void setConstraints(Component comp, GridBagConstraints cons)\n                    – Here, comp is the component for which the constraints cons apply.                    ",
      "autoResize": false,
      "lineHeight": 1.25
    },

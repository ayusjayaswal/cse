      "updated": 1764465720918,
      "link": null,
      "locked": false,
      "text": "static thread currentThread()\n    returns a reference to the same thread\n    use this reference to sleep(), isAlive() etc\n    println(currentThread()) gives\n        [threadName,priority,threadGtoup]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "static thread currentThread()\n    returns a reference to the same thread\n    use this reference to sleep(), isAlive() etc\n    println(currentThread()) gives\n        [threadName,priority,threadGtoup]",
      "autoResize": true,
      "lineHeight": 1.25
    },

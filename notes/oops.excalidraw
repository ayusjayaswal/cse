      "updated": 1764729634925,
      "link": null,
      "locked": false,
      "text": "Queue<String> queue = new LinkedList<>();\nqueue.add(\"one\");\nqueue.add(\"two\");\nqueue.add(\"three\");\nqueue.add(\"four\");\nSystem.out.println(queue);\n        \nqueue.remove(\"three\");\nSystem.out.println(queue);\nSystem.out.println(\"Queue Size: \" + queue.size());\n\n\n\n// array to queue\n        \nString nums[] = {\"one\",\"two\",\"three\",\"four\",\"five\"};\nQueue<String> queue = new LinkedList<>();\nCollections.addAll(queue, nums);\n\n\n// queue to array\nString strArray[] = queue.toArray(new String[queue.size()]);",
      "fontSize": 13.51101407827896,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queue<String> queue = new LinkedList<>();\nqueue.add(\"one\");\nqueue.add(\"two\");\nqueue.add(\"three\");\nqueue.add(\"four\");\nSystem.out.println(queue);\n        \nqueue.remove(\"three\");\nSystem.out.println(queue);\nSystem.out.println(\"Queue Size: \" + queue.size());\n\n\n\n// array to queue\n        \nString nums[] = {\"one\",\"two\",\"three\",\"four\",\"five\"};\nQueue<String> queue = new LinkedList<>();\nCollections.addAll(queue, nums);\n\n\n// queue to array\nString strArray[] = queue.toArray(new String[queue.size()]);",
      "autoResize": false,
      "lineHeight": 1.25
    },
